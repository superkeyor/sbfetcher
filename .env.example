# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Generate a random string using: python -c 'import secrets; print(secrets.token_hex())'
SECRET_KEY=your-super-secret-recovery-code-here

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# Hardcoded twice on purpose: POSTGRES_PASSWORD is the raw password;
# in DATABASE_URL, write the same password percent-encoded if it has special characters (e.g. @ -> %40)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME (HOST is service/container name for Docker built-in DNS)
DATABASE_URL=postgresql://user:password@dockerapp_db:5432/dockerapp

# ------------------------------------------------------------------------------
# THIRD-PARTY SERVICES
# ------------------------------------------------------------------------------
# API_KEY=...

